rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountIsActive() {
      return !exists(/databases/$(database)/documents/account_access/$(request.auth.uid))
        || get(/databases/$(database)/documents/account_access/$(request.auth.uid)).data.active == true;
    }

    match /account_access/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /feature_overrides/{flag} {
      allow read: if signedIn() && accountIsActive();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}