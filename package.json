{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "a11y-audit": "start-server-and-test dev http://localhost:5173 'npx @axe-core/cli http://localhost:5173 --save axe-report.json'",
    "a11y-fix": "node scripts/fix-accessibility.js",
    "test:a11y": "npm run a11y-audit",
    "test:a11y-lighthouse": "start-server-and-test dev http://localhost:5173 'lighthouse http://localhost:5173 --only-categories=accessibility --chrome-flags=\"--headless\" --output json --output-path=lighthouse-a11y-report.json'",
    "check:a11y": "npm run lint && npm run test:a11y",
    "test:security": "node scripts/security-test.js",
    "verify:repo-security": "node scripts/verify-security.mjs",
    "verify:security": "npm run verify:repo-security",
    "setup:git-hooks": "node scripts/setup-git-hooks.mjs",
    "check:clone-isolation": "node scripts/check-clone-isolation.mjs"
  },
