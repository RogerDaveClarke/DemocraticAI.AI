{
    "name": "oireachtas-members-api",
    "version": "1.0.0",
    "description": "High-performance API for serving Oireachtas members data",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "node --env-file=../.env.local node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/index.ts",
        "test": "jest",
        "lint": "eslint src/**/*.ts",
        "clean": "rm -rf dist",
        "deploy": "gcloud run deploy oireachtas-api --source . --region=us-west1 --allow-unauthenticated --platform=managed",
        "deploy:api": "npm run deploy"
    },
    "keywords": [
        "oireachtas",
        "irish",
        "parliament",
        "api",
        "cloud-run"
    ],
    "author": "Parliament Explorer",
    "license": "MIT",
    "dependencies": {
        "@google-cloud/bigquery": "^7.9.0",
        "@google-cloud/firestore": "^7.1.0",
        "@google-cloud/logging": "^11.0.0",
        "@google-cloud/vertexai": "^1.4.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/speakeasy": "^2.0.10",
        "axios": "^1.12.2",
        "bcryptjs": "^3.0.2",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "express-rate-limit": "^8.1.0",
        "firebase-admin": "^12.7.0",
        "google-auth-library": "^10.4.1",
        "googleapis": "^164.0.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "jwks-rsa": "^3.2.2",
        "node-cache": "^5.1.2",
        "qrcode": "^1.5.4",
        "speakeasy": "^2.0.0"
    },
    "devDependencies": {
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.5",
        "@types/qrcode": "^1.5.5",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3"
    },
    "overrides": {
        "uuid": "^11.1.1"
    },
    "engines": {
        "node": ">=18"
    }
}
